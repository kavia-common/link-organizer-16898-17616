# Copy this file to .env and fill in your Supabase project details.
# IMPORTANT:
# - In Create React App, env variables MUST be prefixed with REACT_APP_
# - After changing env vars, you MUST restart the dev server (npm start)

# Supabase Project Settings (from https://app.supabase.com > Project Settings > API)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional: used for Supabase email confirmation redirect after user signs up.
# Set to your local URL in development, or your deployed URL in production.
REACT_APP_SITE_URL=http://localhost:3000
