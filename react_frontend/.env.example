# Frontend environment variables
# Copy this file to `.env` and fill values. Then restart `npm start`.

# Required for Supabase client (Direct mode and auth)
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: When set, the frontend will use the Express backend for authenticated routes
# Example: http://localhost:4000
REACT_APP_API_BASE=

# Optional: Used for email confirmation redirect during sign up
REACT_APP_SITE_URL=http://localhost:3000
