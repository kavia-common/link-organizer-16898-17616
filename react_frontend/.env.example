# Frontend environment variables
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional: If you want the frontend to call the Express backend instead of direct Supabase
# Example: http://localhost:4000
REACT_APP_API_BASE=

# Optional: Used for Supabase email confirmation redirect during sign up
REACT_APP_SITE_URL=http://localhost:3000
